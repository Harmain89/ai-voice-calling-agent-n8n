      "parameters": {
        "jsCode": "const item = $input.first();\nconst toolCalls = item.json.body?.message?.toolCallList || [];\n\nreturn toolCalls.map(toolCall => {\n  const args = toolCall.function?.['arguments'] || {};\n  return {\n    json: {\n      ...item.json,\n      toolCallId: toolCall.id,\n      toolCallName: toolCall.function?.name,\n      toolCallType: args.Type,\n      propertySearchDetails: args['Property search details'],\n      name: args.Name,\n      email: args.Email,\n      phone: args.Phone,\n      viewingTime: args.Viewing_Time,\n      bookingAddress: args.Booking_address,\n    }\n  };\n});"
      },
      "id": "726f6763-cfac-481f-8153-4ae718997f5d",
      "name": "Extract Tool Args",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
